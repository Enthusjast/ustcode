{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ustcode-files",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "workers_dev": false,
  "preview_urls": false,
  "env": {
    "dev": {
      "name": "ustcode-dev-files",
      "routes": [{ "pattern": "dev-files.ustcode.enthusjast.cc", "custom_domain": true }],
      "r2_buckets": [{ "binding": "FILES", "bucket_name": "ustcode-dev-files" }],
    },
    "production": {
      "name": "ustcode-production-files",
      "routes": [{ "pattern": "files.ustcode.enthusjast.cc", "custom_domain": true }],
      "r2_buckets": [{ "binding": "FILES", "bucket_name": "ustcode-production-files" }],
    },
  },
}
