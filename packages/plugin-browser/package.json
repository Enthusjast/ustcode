{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@ustcode-ai/plugin-browser",
  "version": "3.0.0",
  "description": "USTCode's desktop browser plugin",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Enthusjast/ustcode.git",
    "directory": "packages/plugin-browser"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./rpc": "./src/rpc.ts",
    "./proxy": "./src/proxy.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsgo --noEmit -p tsconfig.test.json",
    "test": "bun test"
  },
  "dependencies": {
    "@ustcode-ai/plugin": "workspace:*",
    "@ustcode-ai/schema": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@tsconfig/bun": "catalog:",
    "@types/bun": "catalog:",
    "@typescript/native-preview": "catalog:",
    "typescript": "catalog:"
  }
}
